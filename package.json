{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs vite build && npm run db:migrate",
    "typecheck": "tsc --noEmit",
    "check:catalog": "node scripts/assemble-catalog.mjs && node scripts/check-catalog-invariant.mjs",
    "check:catalog:strict": "node scripts/assemble-catalog.mjs && node scripts/check-catalog-invariant.mjs --strict",
    "assemble:catalog": "node scripts/assemble-catalog.mjs",
    "test": "node --test 'scripts/**/*.test.mjs' && node scripts/assemble-catalog.mjs && node scripts/check-catalog-invariant.mjs",
    "lint": "eslint ."
  }
}
